# Copy to .env on the server. NEVER commit .env (it is git-ignored).
# Generate secrets with:  openssl rand -base64 48

COMPOSE_PROJECT_NAME=hisaab
DOMAIN=portal.example.com          # your domain (DNS A record -> this VPS); `localhost` for a local trial

# The app connects as POSTGRES_USER, a restricted role (not a superuser). A separate admin login is for restore tests.
POSTGRES_USER=hisaab
POSTGRES_DB=hisaab
POSTGRES_PASSWORD=
POSTGRES_ADMIN_PASSWORD=
JWT_SECRET=

# First admin account (created once). Change the password after the first login.
BOOTSTRAP_ADMIN_NAME=Owner
BOOTSTRAP_ADMIN_PHONE=
BOOTSTRAP_ADMIN_PASSWORD=

# Open client questions (ARCHITECTURE.md section 15): these only set defaults.
FIN_YEAR_START_MONTH=4             # 4 = April-March, 7 = July-June, 1 = calendar year
CURRENCY_SYMBOL=Rs
BUSINESS_NAME=Construction Material Supply

# Backups: 30 daily + 12 monthly kept on the VPS. Set an off-site remote to copy them to B2 / S3.
BACKUP_KEEP_DAILY=30
BACKUP_KEEP_MONTHLY=12
BACKUP_OFFSITE_REMOTE=             # e.g. offsite:my-bucket/hisaab   (empty = no off-site copy)
RCLONE_TYPE=s3
RCLONE_PROVIDER=                   # Other / AWS / Backblaze ...
RCLONE_ENDPOINT=                   # e.g. https://s3.eu-central-003.backblazeb2.com
RCLONE_ACCESS_KEY_ID=
RCLONE_SECRET_ACCESS_KEY=
