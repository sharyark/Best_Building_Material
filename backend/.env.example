# Copy to backend/.env for local development (docker-compose uses the root .env instead).
ENV=dev
DATABASE_URL=postgresql+psycopg://hisaab:hisaab@localhost:5432/hisaab
# Dev convenience: create tables from the models instead of running `alembic upgrade head`.
AUTO_CREATE_TABLES=false
JWT_SECRET=change-me-in-env
COOKIE_SECURE=false
CORS_ORIGINS=["http://localhost:5173"]

# Business defaults (open client questions, see ARCHITECTURE.md section 15)
FIN_YEAR_START_MONTH=4
CURRENCY_SYMBOL=Rs
BUSINESS_NAME=Construction Material Supply

# First admin, created once by `python -m app.bootstrap`. CHANGE THE PASSWORD after first login.
BOOTSTRAP_ADMIN_NAME=Owner
BOOTSTRAP_ADMIN_PHONE=admin
BOOTSTRAP_ADMIN_PASSWORD=admin12345
